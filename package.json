{
  "name": "dsh-session-archive-panel",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：设置里加「归档会话」页，可搜索、逐条或全部恢复、彻底删除已归档对话；工作区侧栏不显示任何已归档会话。",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "archive",
    "sessions",
    "settings"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": "Listgone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Listgone/dsh-session-archive-panel.git"
  },
  "homepage": "https://github.com/Listgone/dsh-session-archive-panel#readme",
  "bugs": {
    "url": "https://github.com/Listgone/dsh-session-archive-panel/issues"
  }
}
